{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Content Hub",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "shell:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.apify.com/**" },
        { "url": "https://api.moonshot.cn/**" }
      ]
    }
  ]
}
